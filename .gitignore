# Conteudo inicial do site principal.
# Estes JSONs entram no git para que a versao publicada no GitHub abra com o
# mesmo conteudo do ambiente local de referencia.
!/storage/content/
!/storage/content/*.json
!/storage/content/.gitkeep

# Imagens enviadas pelo painel continuam fora do git e persistem via volume
# Docker - ver docker-compose.yml.
/storage/uploads/*
!/storage/uploads/.gitkeep

# Copia de seguranca automatica gerada no servidor antes de uma restauracao de
# backup (ver app/Support/BackupManager.php) - nunca deve ir para o git.
/storage/backups-seguranca/*
!/storage/backups-seguranca/.gitkeep
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
