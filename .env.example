APP_NAME="Departamento Modelo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8097

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Este projeto nao usa banco de dados. Sessao, cache e fila ficam em arquivo/memoria.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# Credenciais do painel admin (sem tabela de usuarios / sem banco).
# Gere com: docker compose exec app php artisan admin:senha "nova-senha"
# (guardado em base64 porque o hash bcrypt cru, com "$", e truncado pelo Docker Compose
# ao carregar o .env - ver app/Console/Commands/GerarSenhaAdmin.php)
ADMIN_EMAIL=admin@departamento.br
ADMIN_PASSWORD_HASH_B64=

# So mude para true depois que o dominio final tiver certificado HTTPS configurado.
FORCE_HTTPS=false

# Antivirus para uploads do painel (opcional). So funciona se voce tambem subir
# o servico clamav: docker compose --profile clamav up -d --build
CLAMAV_ENABLED=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
