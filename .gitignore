# Conteudo editado pela secretaria pelo painel admin e imagens enviadas.
# Ficam fora do git de proposito (sao dados de cada implantacao, nao do template)
# e persistem via volume Docker - ver docker-compose.yml.
/storage/content/*
!/storage/content/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep

# Copia de seguranca automatica gerada no servidor antes de uma restauracao de
# backup (ver app/Support/BackupManager.php) - nunca deve ir para o git.
/storage/backups-seguranca/*
!/storage/backups-seguranca/.gitkeep
/vendor
_ide_helper.php
